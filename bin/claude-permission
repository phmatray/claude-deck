#!/usr/bin/env node
"use strict";
// PermissionRequest hook: put Claude Code's permission prompt on the Stream Deck
// as two keys, Autoriser / Refuser.
//
// The terminal dialog stays up while this runs and whichever answer comes first
// wins, so this never blocks the keyboard. When the user answers in the terminal
// instead, the deck question is withdrawn — detected through the session's event
// log written by the streamdeck-claude status hooks (skipped if absent).
//
// stdin   PermissionRequest hook input
// stdout  {"hookSpecificOutput":{…"decision":{…}}} on a key press, nothing otherwise
const fs = require("fs");
const os = require("os");
const path = require("path");
const { spawn } = require("child_process");

const ASK_TIMEOUT_S = 100; // below the hook timeout in hooks.json, so claude-ask cleans up itself
const POLL_MS = 150;
// Tools whose dialog is not a yes/no on a call: allowing them from a key would skip their own UI.
const SKIP_TOOLS = new Set(["AskUserQuestion"]);

const input = JSON.parse(fs.readFileSync(0, "utf8") || "{}");
if (!input.tool_name || SKIP_TOOLS.has(input.tool_name)) process.exit(0);

/** 1-3 words for the question key: what is being asked, not which tool asks. */
function header({ tool_name: tool, tool_input: args = {} }) {
  if (tool === "Bash" && typeof args.command === "string") {
    return args.command.trim().split(/\s+/).slice(0, 3).join(" ").slice(0, 28);
  }
  if (typeof args.file_path === "string") return `${tool} ${path.basename(args.file_path)}`;
  if (typeof args.notebook_path === "string") return `${tool} ${path.basename(args.notebook_path)}`;
  if (typeof args.url === "string") {
    try {
      return `${tool} ${new URL(args.url).hostname}`;
    } catch {}
  }
  return tool.startsWith("mcp__") ? tool.split("__").pop() : tool;
}

const eventLog = input.session_id
  ? path.join(os.homedir(), ".claude", "sessions", `${input.session_id}.events.ndjson`)
  : null;
const readEvents = () => {
  try {
    return fs.readFileSync(eventLog, "utf8").split("\n").filter(Boolean);
  } catch {
    return null;
  }
};
const baseline = eventLog ? readEvents() : null;

/** True once the session moved on without us: any new event but the idle-prompt Notification. */
function resolvedElsewhere() {
  if (!baseline) return false;
  const now = readEvents();
  if (!now) return false;
  return now.slice(baseline.length).some((line) => {
    try {
      return JSON.parse(line).event !== "Notification";
    } catch {
      return false; // partial line mid-write
    }
  });
}

const question = {
  header: header(input),
  question: input.tool_input ? JSON.stringify(input.tool_input) : input.tool_name,
  context: path.basename(input.cwd || process.cwd()),
  timeout: ASK_TIMEOUT_S,
  options: [{ label: "Autoriser" }, { label: "Refuser" }],
};

const ask = spawn(path.join(__dirname, "claude-ask"), [], { stdio: ["pipe", "pipe", "ignore"] });
let out = "";
ask.stdout.on("data", (c) => (out += c));
ask.stdin.end(JSON.stringify(question));

const watcher = setInterval(() => {
  if (resolvedElsewhere()) {
    clearInterval(watcher);
    ask.kill("SIGTERM"); // claude-ask removes question.json → the deck returns to its profile
  }
}, POLL_MS);

ask.on("exit", (code) => {
  clearInterval(watcher);
  if (code !== 0) process.exit(0); // withdrawn, "Use terminal", timed out or deck busy: the dialog decides
  let answer;
  try {
    answer = JSON.parse(out);
  } catch {
    process.exit(0);
  }
  const decision =
    answer.index === 0
      ? { behavior: "allow" }
      : { behavior: "deny", message: "Refusé depuis le Stream Deck." };
  process.stdout.write(JSON.stringify({ hookSpecificOutput: { hookEventName: "PermissionRequest", decision } }));
  process.exit(0);
});
