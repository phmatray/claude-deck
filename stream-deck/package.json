{
  "name": "claude-deck-stream-deck",
  "version": "3.0.1",
  "private": true,
  "type": "module",
  "description": "Claude Deck Stream Deck plugin: session dashboard, usage keys and answer keys",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "rollup -c && node scripts/build-profile.mjs",
    "watch": "rollup -c -w --watch.onEnd=\"bash scripts/reload-plugin.sh\"",
    "icons:render": "tsx scripts/render-icons.mjs",
    "icons:static": "node scripts/render-static-pngs.mjs",
    "docs:render": "tsx scripts/render-deck-docs.mts",
    "sd:link": "bash scripts/link-plugin.sh",
    "sd:unlink": "bash scripts/unlink-plugin.sh",
    "sd:validate": "streamdeck validate com.phmatray.claudedeck.sdPlugin --no-update-check",
    "sd:pack": "streamdeck pack com.phmatray.claudedeck.sdPlugin --output ../dist/ --force --no-update-check",
    "sd:dev": "streamdeck dev",
    "sd:reload": "bash scripts/reload-plugin.sh",
    "probe:states": "tsx scripts/probe-states.ts",
    "banner:render": "tsx scripts/render-banner.mts"
  },
  "devDependencies": {
    "@elgato/cli": "^1.7.4",
    "@resvg/resvg-js": "^2.6.2",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^15.2.2",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.0",
    "@tsconfig/node20": "^20.1.2",
    "@types/node": "~20.19.0",
    "rollup": "^4.0.2",
    "tslib": "^2.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "@elgato/streamdeck": "^1.0.0"
  }
}
