{
  "description": "Answer Claude Code permission prompts from the Stream Deck (Autoriser / Refuser)",
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/claude-permission", "timeout": 120 }
        ]
      }
    ]
  }
}
