#!/usr/bin/env node
"use strict";
// PermissionRequest hook: put Claude Code's permission prompt on the Stream Deck
// as Autoriser / Toujours / Refuser keys — Continuer à planifier / Approuver au
// terminal for a plan — queued per session through claude-ask.
//
// The terminal dialog stays up while this runs and whichever answer comes first
// wins, so this never blocks the keyboard. When the user answers in the terminal
// instead, the deck question is withdrawn — detected through the session's event
// log written by the plugin's status hooks (hooks/notification.sh; skipped if absent).
//
// stdin   PermissionRequest hook input
// stdout  {"hookSpecificOutput":{…"decision":{…}}} on a key press, nothing otherwise
const fs = require("fs");
const os = require("os");
const path = require("path");
const { spawn } = require("child_process");

const ASK_TIMEOUT_S = 100; // below the hook timeout in hooks.json, so claude-ask cleans up itself
const POLL_MS = 150;
// Tools whose dialog is not a yes/no on a call: allowing them from a key would skip their own UI.
const SKIP_TOOLS = new Set(["AskUserQuestion"]);

const input = JSON.parse(fs.readFileSync(0, "utf8") || "{}");
if (!input.tool_name || SKIP_TOOLS.has(input.tool_name)) process.exit(0);

/** The call's arguments. `tool_input` is whatever the hook was handed: a destructuring
 *  default would let a null through, and reading a property off it kills the hook before
 *  the deck ever sees the prompt. Both readers below go through here. */
const argsOf = (input) => (input && typeof input === "object" ? input : {});

/** 1-3 words for the header key: what is being asked, not which tool asks. */
function header({ tool_name: tool, tool_input }) {
  const args = argsOf(tool_input);
  if (tool === "ExitPlanMode") return "Plan prêt";
  if (tool === "Bash" && typeof args.command === "string") {
    return args.command.trim().split(/\s+/).slice(0, 3).join(" ").slice(0, 28);
  }
  const name = tool.startsWith("mcp__") ? tool.split("__").pop() : tool;
  if (typeof args.file_path === "string") return `${name} ${path.basename(args.file_path)}`;
  if (typeof args.notebook_path === "string") return `${name} ${path.basename(args.notebook_path)}`;
  if (typeof args.url === "string") {
    try {
      return `${name} ${new URL(args.url).hostname}`;
    } catch {}
  }
  return name;
}

const eventLog = input.session_id
  ? path.join(os.homedir(), ".claude", "sessions", `${input.session_id}.events.ndjson`)
  : null;
const readEvents = () => {
  try {
    return fs.readFileSync(eventLog, "utf8").split("\n").filter(Boolean);
  } catch {
    return null;
  }
};
const baseline = eventLog ? readEvents() : null;

/** Log lines that arrive while the prompt is still open: the permission-prompt
 *  Notification, and a PermissionRequest line should the status hook ever log that
 *  event (it runs in parallel with this hook, so it can land after the baseline). */
const STILL_WAITING = new Set(["Notification", "PermissionRequest"]);

/** True once the session moved on without us: any new event the open prompt can't explain. */
function resolvedElsewhere() {
  if (!baseline) return false;
  const now = readEvents();
  if (!now) return false;
  return now.slice(baseline.length).some((line) => {
    try {
      return !STILL_WAITING.has(JSON.parse(line).event);
    } catch {
      return false; // partial line mid-write
    }
  });
}

const firstLine = (text) => (text.split("\n").find((l) => l.trim()) ?? "").trim();

/** Edit/MultiEdit: the first line of what changes into the first line of what replaces it; Write: its size. */
function editHint(tool, args) {
  const edits = tool === "Edit" ? [args] : tool === "MultiEdit" && Array.isArray(args.edits) ? args.edits : [];
  const [edit] = edits;
  if (typeof edit?.old_string === "string" && typeof edit.new_string === "string") {
    const more = edits.length > 1 ? ` (+${edits.length - 1} more)` : "";
    // An empty replacement is a deletion; a bare "foo →" would read as cut off.
    return `${firstLine(edit.old_string)} → ${firstLine(edit.new_string) || '""'}${more}`;
  }
  if (tool === "Write" && typeof args.content === "string") {
    const lines = args.content ? args.content.split("\n").length - (args.content.endsWith("\n") ? 1 : 0) : 0;
    return `new file, ${lines} line${lines === 1 ? "" : "s"}`;
  }
  return undefined;
}

/** The call spelled out across the detail keys (two rows of them), so the deck can be
 *  answered without reading the terminal: the command, the file, the URL, the plan. */
function detail({ tool_name: tool, tool_input: input }) {
  const args = argsOf(input);
  // Heading markers are noise on a 13-column key; the text under them is the plan.
  if (tool === "ExitPlanMode" && typeof args.plan === "string") return args.plan.replace(/^#{1,6}[ \t]+/gm, "");
  if (tool === "Bash" && typeof args.command === "string") {
    return typeof args.description === "string" && args.description ? `${args.command}\n\n${args.description}` : args.command;
  }
  // Before the file branch: an MCP tool taking a file_path still needs its name and full input shown.
  if (tool.startsWith("mcp__")) {
    const [, server, ...name] = tool.split("__");
    return `${server} › ${name.join("__")}\n${JSON.stringify(args)}`;
  }
  const file = typeof args.file_path === "string" ? args.file_path : args.notebook_path;
  if (typeof file === "string") {
    const hint = editHint(tool, args);
    return hint ? `${file}\n${hint}` : file;
  }
  if (tool === "WebFetch" && typeof args.url === "string") return args.url;
  return input ? JSON.stringify(input) : tool;
}

/** Option id → hook decision. Answers are mapped by id, never by key position. */
const DECISIONS = {
  allow: { behavior: "allow" },
  deny: { behavior: "deny", message: "Refusé depuis le Stream Deck." },
  // VERIFIED on Claude Code 2.1.27x: a hook "allow" does not approve a plan, the dialog
  // just stays up — a deny does get through. So a plan key can only send Claude back to
  // planning; approving stays the terminal's job, and "terminal" has no decision at all.
  revise: {
    behavior: "deny",
    message: "L'utilisateur veut continuer à planifier : ne lance pas le plan, demande-lui ce qu'il faut changer.",
  },
};

const isPlan = input.tool_name === "ExitPlanMode";

/** What "Toujours" stores: Claude Code's own first "allow these calls from now on" rule,
 *  echoed back verbatim in updatedPermissions. The terminal dialog offers a broader rule
 *  of its own ("python3 *"); inventing one here would grant more than the deck shows. */
const alwaysRule = isPlan
  ? null
  : (Array.isArray(input.permission_suggestions) ? input.permission_suggestions : []).find(
      (s) => s?.type === "addRules" && s.behavior === "allow" && typeof s.rules?.[0]?.toolName === "string",
    );
if (alwaysRule) DECISIONS.always = { behavior: "allow", updatedPermissions: [alwaysRule] };

/** That rule spelled out on the last detail line, so "Toujours" is never a blind press.
 *  A suggestion may carry several rules and the key stores all of them, so the extra ones
 *  are counted rather than left out of what the deck shows. */
function ruleLine({ rules, destination }) {
  const [rule] = rules;
  const content = typeof rule.ruleContent === "string" ? `(${rule.ruleContent})` : "";
  const more = rules.length > 1 ? ` (+${rules.length - 1} more)` : "";
  return `Toujours = ${rule.toolName}${content}${more}${destination ? ` · ${destination}` : ""}`;
}

const question = {
  // Plan approval keeps its own state on the dashboard (awaiting_plan), not the generic permission one.
  kind: isPlan ? "plan" : "permission",
  sessionId: input.session_id,
  header: header(input),
  detail: alwaysRule ? `${detail(input)}\n${ruleLine(alwaysRule)}` : detail(input),
  question: input.tool_input ? JSON.stringify(input.tool_input) : input.tool_name,
  context: path.basename(input.cwd || process.cwd()),
  timeout: ASK_TIMEOUT_S,
  options: isPlan
    ? [
        { id: "revise", label: "Continuer à planifier" },
        { id: "terminal", label: "Approuver au terminal" },
      ]
    : [
        { id: "allow", label: "Autoriser" },
        ...(alwaysRule ? [{ id: "always", label: "Toujours" }] : []),
        { id: "deny", label: "Refuser" },
      ],
};

const ask = spawn(path.join(__dirname, "claude-ask"), [], { stdio: ["pipe", "pipe", "ignore"] });
let out = "";
ask.stdout.on("data", (c) => (out += c));
ask.stdin.end(JSON.stringify(question));

// Claude Code may kill this hook once the dialog is answered: take the deck question
// down with it rather than leave it waiting out its timeout.
for (const sig of ["SIGINT", "SIGTERM", "SIGHUP"]) {
  process.on(sig, () => {
    ask.kill("SIGTERM");
    process.exit(0);
  });
}

const watcher = setInterval(() => {
  if (resolvedElsewhere()) {
    clearInterval(watcher);
    ask.kill("SIGTERM"); // claude-ask deletes its own question file → it leaves the deck
  }
}, POLL_MS);

ask.on("exit", (code) => {
  clearInterval(watcher);
  if (code !== 0) process.exit(0); // withdrawn, "Terminal", timed out or bad input: the dialog decides
  let answer;
  try {
    answer = JSON.parse(out);
  } catch {
    process.exit(0);
  }
  const decision = DECISIONS[answer.optionId];
  if (!decision) process.exit(0);
  process.stdout.write(JSON.stringify({ hookSpecificOutput: { hookEventName: "PermissionRequest", decision } }));
  process.exit(0);
});
